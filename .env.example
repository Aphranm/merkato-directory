# Copy to .env and replace every placeholder before starting the services.
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=replace-with-a-random-secret
JWT_SECRET=replace-with-a-different-random-secret
CORS_ORIGINS=http://localhost:5173

# PostgreSQL
POSTGRES_DB=merkato_directory
POSTGRES_USER=merkato_app
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_PORT=55432
DATABASE_URL=postgresql+psycopg2://merkato_app:replace-with-a-strong-database-password@localhost:55432/merkato_directory

